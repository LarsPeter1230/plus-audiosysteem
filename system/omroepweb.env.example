# Omroepweb — omgevingsvariabelen (secrets).
# Kopieer dit bestand naar  omroepweb.env  in de app-map en vul je eigen waarden in.
# Dit bestand wordt door install.sh als EnvironmentFile aan de systemd-service gekoppeld.
# NOOIT committen (staat in .gitignore).

# Flask session secret (verzin een lange willekeurige string)
SECRET_KEY=verander-mij-in-iets-langs-en-willekeurigs

# PIN om de eerste admin aan te maken / te herstellen
ADMIN_PIN=000000

# ── OIDC / SSO (optioneel; leeg laten = lokale login) ──
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISCOVERY_URL=
OIDC_REDIRECT_URI=

# ── Spotify (lokale go-librespot op de VM) ──
# 1 = Spotify volledig lokaal op de VM (standaard). 0 = oude Pi-modus (rollback).
PI_LOCAL_GLR=1
